---
import "../styles/global.css";
import site from "../data/site.json";

const title = `${site.name} — ${site.role}`;
const description = site.tagline;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      // reversible reveal: fade in entering viewport, fade back out on leave
      // (reduced motion handled in CSS)
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            e.target.classList.toggle("is-visible", e.isIntersecting);
          }
        },
        // bottom margin pulls the trigger line up from the viewport edge, so
        // scrolling back up fades rows out while they're still on screen
        { threshold: 0, rootMargin: "0px 0px -18% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
