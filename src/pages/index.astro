---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import experience from "../data/experience.json";
import projects from "../data/projects.json";

const shortNotes: Record<string, string> = {
  "Stealth AI Startup": "Built an LLM-agent evaluation benchmark end to end as sole owner, and prototyped a reflection component for the production backend.",
  "Arbor Live": "Coordinated marketing and social media for the Stanford chapter.",
  Joyme: "Worked remotely as an AIGC product management intern.",
};

const shortDesc: Record<string, string> = {
  Showdown: "Terminal poker vs. a trash-talking LLM.",
  "Optimal Ban Selection in League of Legends": "Ban value as counterfactual, 182k ranked games.",
  "One-Dimensional Heat Equation": "FTCS solver, validated against analytical solutions.",
  "Logistic Regression from Scratch": "Log-likelihood gradient ascent, no ML libs.",
};
---

<Base>
  <div class="split">
    <div class="text">
      <h1>{site.name}</h1>
      <p class="meta">Math @ Stanford · Researcher</p>
      <p class="contacts">
        <span>{site.email}</span>
        <a href={site.github}>github</a>
        <a href={site.linkedin}>linkedin</a>
        <a href={site.resume} download="Haohan-Wu-CV.pdf">cv</a>
      </p>
      <p class="bio">LLM-agent eval research.</p>

      <section>
        <h2>Experience</h2>
        {experience.map((e) => (
          <div class="entry">
            <span class="period">{e.period}</span>
            <span><span class="org">{e.org}</span>, {e.role} — {shortNotes[e.org] ?? ""}</span>
          </div>
        ))}
      </section>

      <section>
        <h2>Selected work</h2>
        {projects.map((p) => (
          <div class="proj">
            <div class="row-head">
              <h3>{p.title}</h3>
              <span class="yr">{p.year}</span>
            </div>
            <p>{shortDesc[p.title] ?? p.description}</p>
            <div class="tech">
              {p.tech.slice(0, 2).join(" · ")}
              {p.links.map((l) => <a href={l.url}> · {l.label} ↗</a>)}
            </div>
          </div>
        ))}
      </section>
    </div>

    <div class="images">
      <div class="img-slot stilllife">
        <img src="/images/rijks-stilllife.jpg" alt="Autochrome still life photograph of a copper kettle and vegetables" />
      </div>
      <p class="credit">Anonymous, <em>Stilleven met fruit, groenten en een koperen ketel</em>, Rijksmuseum, public domain</p>
    </div>
  </div>
</Base>

<style>
  :global(body) {
    background: #f7f6f2;
    color: #0d0d0d;
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 400;
    line-height: 1.6;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr;
  }

  .text {
    padding: 3rem 1.5rem 4rem 1ch;
  }
  @media (min-width: 700px) { .text { padding: 4.5rem 3rem 5rem 1ch; } }
  @media (min-width: 900px) { .text { padding: 5.5rem 2rem 6rem 1ch; max-width: 34rem; } }

  .images {
    order: -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: clamp(275px, 32.5vw, 475px);
    max-width: calc(100vw - 4ch);
    margin: 2rem auto 0;
  }
  @media (min-width: 900px) {
    .images {
      order: initial;
      position: fixed;
      top: 50%;
      right: 2ch;
      transform: translateY(-50%);
      margin: 0;
    }
  }

  .img-slot {
    position: relative;
    width: clamp(275px, 32.5vw, 475px);
    max-width: 100%;
    aspect-ratio: 6396 / 4250;
    background-color: #e9e7e0;
    background-image: repeating-linear-gradient(45deg, #d3d0c4 0, #d3d0c4 1px, transparent 1px, transparent 11px);
    overflow: hidden;
  }

  .img-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.15);
  }

  .credit {
    padding: 0.5rem 1ch;
    color: #6b6b6b;
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }
  .credit em { font-style: italic; }

  h1 {
    font-weight: 900;
    font-size: clamp(2.4rem, 6vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .meta {
    margin-top: 0.9rem;
    font-size: 0.8rem;
    color: #6b6b6b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .contacts {
    margin-top: 0.75rem;
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
  }
  .contacts a { color: #0d0d0d; }
  .contacts a:hover { color: #6b6b6b; }

  .bio {
    margin-top: 1.5rem;
    max-width: 42ch;
    font-size: 1rem;
    color: #2a2a2a;
  }

  section { margin-top: 2.25rem; }

  h2 {
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b6b6b;
    margin-bottom: 1.75rem;
  }

  /* experience — bare list, no rules, whitespace carries the rhythm */
  .entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    padding-bottom: 0.8rem;
  }
  .entry:last-child { padding-bottom: 0; }
  @media (min-width: 560px) {
    .entry { grid-template-columns: 7rem 1fr; gap: 0.5rem; align-items: baseline; }
  }
  .entry .period { font-size: 0.78rem; color: #6b6b6b; }
  .entry .org { font-weight: 700; }

  /* projects — uniform rows, title+year as the row head */
  .proj { padding-bottom: 1.1rem; }
  .proj:last-child { padding-bottom: 0; }
  .proj .row-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .proj h3 { font-weight: 700; font-size: 1.1rem; }
  .proj .yr { font-size: 0.75rem; color: #6b6b6b; }
  .proj p { margin-top: 0.5rem; color: #2a2a2a; font-size: 0.92rem; }
  .proj .tech { margin-top: 0.6rem; font-size: 0.75rem; color: #6b6b6b; }
  .proj a { color: #0d0d0d; text-decoration: underline; text-underline-offset: 2px; }
  .proj a:hover { color: #6b6b6b; }

  :global(:focus-visible) { outline: 2px solid #0d0d0d; outline-offset: 3px; }
</style>
