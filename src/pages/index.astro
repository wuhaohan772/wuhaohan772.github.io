  /* sun shows the current mode is light (click for dark); moon shows
     the current mode is dark (click for light) */
  .icon-moon { display: none; }
  /* class-only selectors (not #dark-toggle) so the id-stripped page
     copy inside the magnifier lens styles the same way */
  :global(html.dark-mode) .icon-sun { display: none; }
  :global(html.dark-mode) .icon-moon { display: block; }

  .split {
