    background: var(--bg);
  }

  :global(body) {
    background: var(--bg);
    color: var(--fg);
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 400;
    line-height: 1.6;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  /* horizontal calligraphy banner, pinned to the top of the viewport
     while the rest of the page scrolls underneath it. Full image,
     no crop — height follows the image's own ~7.75:1 ratio. On
     mobile it's NOT sticky — image, credit and buttons all scroll
     away normally instead of permanently eating screen height. */
  .callig-band {
    position: static;
    width: 100%;
  }
  @media (min-width: 600px) {
    .callig-band {
      position: sticky;
      top: 0;
      z-index: 10;
    }
  }
  .callig-roll { overflow: hidden; }
  .callig-track {
    display: flex;
    width: 200%;
    animation: callig-roll 120s linear infinite;
  }
  @keyframes callig-roll {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .callig-track { animation: none; transform: translateX(-50%); }
  }
  .callig-band picture { display: block; }
  .callig-band img {
    display: block;
    width: 100%;
  }
  .callig-band img {
    height: auto;
    aspect-ratio: 6224 / 774;
  }
  /* below 600px the <picture> swaps to callig-mobile.jpg (a tighter
     detail crop, 2.5:1) instead of squeezing the full 7.75:1 scroll
     down to an illegible sliver — ratio here must match that crop */
  @media (max-width: 599px) {
    .callig-band img {
      aspect-ratio: 2500 / 1000;
    }
  }

  /* credit sits right above the toolbar, both right-aligned. On
     mobile this stays in normal flow, stacked below the image. */
  .band-footer {
