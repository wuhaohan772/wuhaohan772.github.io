---
import experience from "../data/experience.json";
import education from "../data/education.json";
---

<section id="experience">
  <p class="marker reveal">02 — Experience</p>
  <ul>
    {
      experience.map((e) => (
        <li class="reveal">
          <span class="period">{e.period}</span>
          <div>
            <p class="head">
              {e.role} — <span class="org">{e.org}</span>
            </p>
            <p class="notes">{e.notes}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section id="education">
  <p class="marker reveal">03 — Education</p>
  <ul>
    {
      education.map((e) => (
        <li class="reveal">
          <span class="period">{e.period}</span>
          <div>
            <p class="head">
              {e.degree} — <span class="org">{e.org}</span>
            </p>
            <p class="notes">{e.notes}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  section {
    padding: clamp(1.5rem, 3vw, 3rem);
    padding-bottom: 4rem;
  }

  .marker {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-secondary);
    border-bottom: 1px solid var(--color-fg);
    padding-bottom: 0.6rem;
    margin-bottom: var(--space-4);
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: clamp(5rem, 8vw, 8rem) 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  li:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .period {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-secondary);
  }

  .head {
    font-family: var(--font-mono);
    font-weight: 400;
  }

  .org {
    font-weight: 300;
  }

  .notes {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-secondary);
    max-width: var(--measure);
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
