---
const sections = [
  { id: "projects", label: "Projects" },
  { id: "experience", label: "Experience" },
  { id: "education", label: "Education" },
];
---

<div class="rail-anchor">
  <nav class="side" aria-label="Sections">
    {
      sections.map((s) => (
        <a href={`#${s.id}`} data-section={s.id}>
          <span class="dot" />
          {s.label}
        </a>
      ))
    }
  </nav>
</div>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".side a")];
  const secs = links
    .map((a) => document.getElementById(a.dataset.section!))
    .filter((s): s is HTMLElement => s !== null);

  // active = last section whose top has passed the 45% viewport line;
  // at page bottom force the last section (short sections can't reach the line)
  function update() {
    if (secs.length === 0) return;
    const line = innerHeight * 0.45;
    let active = secs[0].id;
    for (const s of secs) {
      if (s.getBoundingClientRect().top <= line) active = s.id;
    }
    if (Math.ceil(scrollY + innerHeight) >= document.body.scrollHeight - 2) {
      active = secs[secs.length - 1].id;
    }
    for (const a of links) {
      a.classList.toggle("active", a.dataset.section === active);
    }
  }

  let ticking = false;
  addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      }
    },
    { passive: true },
  );
  update();
</script>

<style>
  /* in flow just above Projects: rail enters alongside the Projects heading,
     travels up with scroll, then locks at the vertical center */
  .rail-anchor {
    position: sticky;
    top: 45vh;
    height: 0;
    z-index: 20;
  }

  .side {
    position: absolute;
    left: clamp(0.75rem, 2vw, 2rem);
    top: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .side a {
    display: flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    color: var(--color-secondary);
  }

  .side a.active {
    color: var(--color-fg);
    font-weight: 700;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    flex-shrink: 0;
    transition: background 0.2s ease-out;
  }

  .side a.active .dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media (max-width: 1100px) {
    .rail-anchor {
      display: none;
    }
  }
</style>
