---
const sections = [
  { id: "projects", label: "Projects" },
  { id: "experience", label: "Experience" },
  { id: "education", label: "Education" },
];
---

<nav class="linenav" aria-label="Sections">
  {
    sections.map((s) => (
      <a href={`#${s.id}`} data-section={s.id}>
        <span class="dot" />
        {s.label}
      </a>
    ))
  }
</nav>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".linenav a")];
  const secs = links
    .map((a) => document.getElementById(a.dataset.section!))
    .filter((s): s is HTMLElement => s !== null);

  // the right pane is the scroller on desktop; fall back to window on mobile
  const pane = document.querySelector("main");

  // active = last section whose top has passed the 45% viewport line;
  // scroller bottom forces the last section
  function update() {
    if (secs.length === 0 || !pane) return;
    const line = innerHeight * 0.45;
    let active = secs[0].id;
    for (const s of secs) {
      if (s.getBoundingClientRect().top <= line) active = s.id;
    }
    if (Math.ceil(pane.scrollTop + pane.clientHeight) >= pane.scrollHeight - 2) {
      active = secs[secs.length - 1].id;
    }
    for (const a of links) {
      a.classList.toggle("active", a.dataset.section === active);
    }
  }

  let ticking = false;
  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    }
  }
  pane?.addEventListener("scroll", onScroll, { passive: true });
  addEventListener("scroll", onScroll, { passive: true });
  update();
</script>

<style>
  /* sits on the dividing line between the two panes */
  .linenav {
    position: fixed;
    left: var(--split);
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-bg);
    padding-block: 1.8rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .linenav a {
    display: flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    color: var(--color-secondary);
  }

  .linenav a.active {
    color: var(--color-fg);
    font-weight: 700;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    flex-shrink: 0;
    transition: background 0.2s ease-out;
  }

  .linenav a.active .dot {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media (max-width: 1000px) {
    .linenav {
      display: none;
    }
  }
</style>
