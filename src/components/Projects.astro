---
import projects from "../data/projects.json";
---

<section id="projects">
  <div class="container">
    <h2 class="reveal">Projects</h2>
    <ol>
      {
        projects.map((p, i) => (
          <li class="reveal">
            <div class="index">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <span class="year">{p.year}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.description}</p>
            <div class="meta">
              <span class="tech">{p.tech.join(" · ")}</span>
              {p.links.map((l) => (
                <a href={l.url}>{l.label} ↗</a>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  section {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  h2 {
    font-size: var(--text-section);
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-4);
    position: relative;
    z-index: 0;
  }

  /* ghost numeral behind the heading */
  h2::before {
    content: "01";
    position: absolute;
    z-index: -1;
    left: -0.06em;
    top: 50%;
    transform: translateY(-52%);
    font-size: clamp(7rem, 14vw, 12rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: color-mix(in srgb, var(--color-fg) 5%, var(--color-bg));
    pointer-events: none;
  }

  /* project boxes — bordered blocks in a two-up grid (jamespants-style) */
  ol {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  li {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    padding: var(--space-4);
    transition:
      border-color 0.2s ease-out,
      background-color 0.2s ease-out;
  }

  /* hover inverts the box */
  li:hover {
    border-color: var(--color-fg);
    background: var(--color-fg);
  }

  li h3,
  li p,
  li .index,
  li .tech,
  li .meta a {
    transition: color 0.2s ease-out;
  }

  li:hover h3,
  li:hover .meta a {
    color: var(--color-bg);
  }

  li:hover p,
  li:hover .index,
  li:hover .tech {
    color: color-mix(in srgb, var(--color-bg) 72%, var(--color-fg));
  }

  .index {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-secondary);
    margin-bottom: var(--space-3);
  }

  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 400;
    margin-bottom: var(--space-1);
  }

  li p {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-secondary);
    margin-bottom: var(--space-3);
  }

  .meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    align-items: baseline;
  }

  .tech {
    color: var(--color-secondary);
  }

  @media (max-width: 800px) {
    ol {
      grid-template-columns: 1fr;
    }
  }
</style>
