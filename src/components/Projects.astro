---
import projects from "../data/projects.json";
---

<section id="projects">
  <p class="marker reveal">01 — Projects</p>
  <ol>
    {
      projects.map((p, i) => (
        <li class="reveal">
          <div class="index">
            <span>{String(i + 1).padStart(2, "0")}</span>
            <span>{p.year}</span>
          </div>
          <div class="body">
            <h2>{p.title}</h2>
            <p class="desc">{p.description}</p>
            <p class="tech">{p.tech.join(" · ")}</p>
          </div>
          <div class="links">
            {p.links.map((l) => <a href={l.url}>{l.label} ↗</a>)}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  section {
    padding: clamp(1.5rem, 3vw, 3rem);
    padding-left: clamp(6rem, 9vw, 9rem); /* gutter for the line menu */
    padding-bottom: 4rem;
  }

  .marker {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-secondary);
    border-bottom: 1px solid var(--color-fg);
    padding-bottom: 0.6rem;
    margin-bottom: var(--space-4);
  }

  ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* long box: index | body | links */
  li {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: var(--space-3);
    border: 1px solid var(--color-border);
    padding: var(--space-3);
    transition:
      border-color 0.2s ease-out,
      background-color 0.2s ease-out;
  }

  li:hover {
    border-color: var(--color-fg);
    background: color-mix(in srgb, var(--color-fg) 4%, var(--color-bg));
  }

  .index {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-secondary);
  }

  h2 {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 400;
    margin-bottom: var(--space-1);
  }

  .desc {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-secondary);
    max-width: 56ch;
    margin-bottom: var(--space-1);
  }

  .tech {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-secondary);
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: flex-end;
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .index,
    .links {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-2);
    }
  }
</style>
