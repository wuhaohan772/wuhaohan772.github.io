---
import site from "../data/site.json";
---

<section id="top">
  <div class="frame">
    <div class="card">
      <p class="role">{site.role} — {site.location}</p>
      <h1>
        {
          site.nameParts.map((p) => (
            <span class="part">
              {p.latin}
              <span class="cjk">{p.cjk}</span>
            </span>
          ))
        }
      </h1>
      <p class="tagline">{site.tagline}</p>
      <p class="bio">{site.bio}</p>
    </div>
  </div>
</section>

<style>
  /* card fills nearly the whole first viewport: thin equal margin all round */
  .frame {
    padding: 2rem;
  }

  .card {
    border: 2px solid color-mix(in srgb, var(--color-fg) 45%, var(--color-bg));
    min-height: calc(100dvh - 3.7rem - 4rem); /* viewport - top bar - frame */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: clamp(2rem, 6vw, 5rem);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.05em;
    margin-bottom: var(--space-3);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 0.3em;
  }

  .part {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cjk {
    font-family: "Noto Sans SC", "PingFang SC", "Hiragino Sans GB",
      "Microsoft YaHei", sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.5rem);
    font-weight: 400;
    letter-spacing: 0.5em;
    margin-right: -0.5em; /* recenter after trailing tracking */
    color: var(--color-secondary);
    margin-top: 0.35em;
  }

  .role {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-secondary);
    margin-bottom: var(--space-3);
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 400;
    max-width: var(--measure);
    margin-bottom: var(--space-2);
  }

  .bio {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    max-width: 52ch;
    color: var(--color-secondary);
  }
</style>
