---
import site from "../data/site.json";
---

<section id="top">
  <div class="frame">
    <div class="card">
      <p class="role">{site.role} — {site.location}</p>
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <p class="bio">{site.bio}</p>
    </div>
  </div>
</section>

<style>
  /* card fills nearly the whole first viewport: thin equal margin all round */
  .frame {
    padding: 2rem;
  }

  .card {
    border: 2px solid color-mix(in srgb, var(--color-fg) 45%, var(--color-bg));
    min-height: calc(100dvh - 3.7rem - 4rem); /* viewport - top bar - frame */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: clamp(2rem, 6vw, 5rem);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
  }

  .role {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-secondary);
    margin-bottom: var(--space-3);
  }

  .tagline {
    font-size: var(--text-lg);
    font-weight: 700;
    max-width: var(--measure);
    margin-bottom: var(--space-2);
  }

  .bio {
    max-width: 48ch;
    color: var(--color-secondary);
  }
</style>
