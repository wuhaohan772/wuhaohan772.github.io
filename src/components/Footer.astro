---
import site from "../data/site.json";
---

<footer>
  <div class="container">
    <p class="colophon">
      © {new Date().getFullYear()} {site.name} · Built with Astro · Hosted on
      GitHub Pages
    </p>
  </div>
</footer>

<style>
  footer {
    padding-block: var(--space-4);
  }

  .colophon {
    font-size: var(--text-sm);
    color: var(--color-secondary);
  }
</style>
