---
import site from "../data/site.json";
---

<footer>
  <p class="colophon">
    © {new Date().getFullYear()} {site.name} · Built with Astro · Hosted on
    GitHub Pages
  </p>
</footer>

<style>
  footer {
    padding: clamp(1.5rem, 3vw, 3rem);
    padding-left: clamp(6rem, 9vw, 9rem);
    padding-top: 0;
  }

  .colophon {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-secondary);
  }
</style>
