---
import site from "../data/site.json";

const tickerItems = [...site.ticker, ...site.ticker];
const contacts = [
  { label: "Email", url: `mailto:${site.email}` },
  { label: "GitHub", url: site.github },
  { label: "LinkedIn", url: site.linkedin },
  { label: "Resume", url: site.resume },
];
---

<aside class="identity" id="top">
  <div class="inner">
    <p class="role">{site.role} — {site.location}</p>
    <div class="mask">
      <h1>{site.name} <span class="cjk">吴皓汉</span></h1>
    </div>
    <p class="tagline">{site.tagline}</p>
    <p class="bio">{site.bio}</p>
    <div class="contacts">
      {contacts.map((c) => <a href={c.url}>{c.label} ↗</a>)}
    </div>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {tickerItems.map((t) => <span>{t}</span>)}
    </div>
  </div>
</aside>

<style>
  .identity {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    border-right: 2px solid var(--color-fg);
    overflow: hidden;
  }

  .inner {
    margin-block: auto;
    padding: clamp(1.5rem, 3.5vw, 3.5rem);
  }

  .role {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-secondary);
    margin-bottom: var(--space-2);
    opacity: 0;
    animation: fadeup 0.5s ease-out 0.35s forwards;
  }

  .mask {
    overflow: hidden;
  }

  h1 {
    font-size: clamp(2.4rem, 4.2vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
    animation: rise 0.7s cubic-bezier(0.2, 0.6, 0.2, 1) both;
  }

  .cjk {
    font-family: "Noto Sans SC", "PingFang SC", "Hiragino Sans GB",
      "Microsoft YaHei", sans-serif;
    font-weight: 400;
    font-size: 0.55em;
    letter-spacing: 0.3em;
    color: var(--color-secondary);
    white-space: nowrap;
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 400;
    margin-bottom: var(--space-2);
    opacity: 0;
    animation: fadeup 0.5s ease-out 0.55s forwards;
  }

  .bio {
    font-family: var(--font-mono);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-secondary);
    max-width: 44ch;
    margin-bottom: var(--space-4);
    opacity: 0;
    animation: fadeup 0.5s ease-out 0.65s forwards;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    opacity: 0;
    animation: fadeup 0.5s ease-out 0.8s forwards;
  }

  .contacts a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-fg);
    padding-bottom: 2px;
  }

  .contacts a:hover {
    border-color: var(--color-accent);
  }

  /* infinite mono strip along the column's bottom edge */
  .ticker {
    border-top: 1px solid var(--color-border);
    overflow: hidden;
    padding-block: 0.7rem;
  }

  .ticker-track {
    display: flex;
    gap: 3rem;
    width: max-content;
    font-family: var(--font-mono), "Noto Sans SC", sans-serif;
    font-weight: 300;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: var(--color-secondary);
    white-space: nowrap;
    animation: scroll 24s linear infinite;
  }

  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }

  .ticker span::after {
    content: "·";
    margin-left: 3rem;
  }

  @keyframes rise {
    from {
      transform: translateY(110%);
    }
    to {
      transform: none;
    }
  }

  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 1000px) {
    .identity {
      position: static;
      height: auto;
      border-right: none;
      border-bottom: 2px solid var(--color-fg);
      min-height: 100dvh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    .role,
    .tagline,
    .bio,
    .contacts {
      animation: none;
      opacity: 1;
    }

    .ticker-track {
      animation: none;
    }
  }
</style>
